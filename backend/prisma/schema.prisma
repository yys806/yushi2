generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  nickname     String
  quotaTotal   Int       @default(5)
  quotaUsed    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  works        Work[]
  favorites    Favorite[]
  orders       Order[]
}

model Work {
  id            String      @id @default(uuid())
  userId        String
  material      String
  pattern       String
  productType   String
  budget        Int
  subject       String
  title         String
  inspiration   String
  meaning       String
  grade         String
  imageUrl      String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoritedBy   Favorite[]

  @@index([userId, createdAt])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  workId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
}

model Order {
  id                String   @id @default(uuid())
  userId            String
  packageType       String
  amount            Float
  times             Int
  payChannel        String
  status            String   @default("pending")
  thirdPartyOrderNo String?
  createdAt         DateTime @default(now())
  paidAt            DateTime?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
